    {
      "method": "POST",
      "path": "/v2/lists/mandate_acquisition/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Mandate acquisition pipeline. Target: Entered when a senior hire or a likely leadership change is identified at a company, with a named sponsor. Introduction: Entered when a partner has met the sponsor and discussed a specific role. Brief: Entered when the client has shared a role brief and agreed to see a proposal. Proposal sent: Entered when a written proposal with approach, timetable and fee has been sent to the sponsor. Pitch or finalist: Entered when the client has invited us to present to a wider group or named us a finalist. Terms agreed: Entered when the client has verbally chosen us and fee, structure and exclusivity are agreed. Mandate won: Entered when the signed search agreement is received and the search record is created. Mandate lost: Entered when the client chooses another route or firm, or cancels the role, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/mandate_acquisition/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
