        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_business/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the New business pipeline. Qualified: Entered when a discovery call is booked with a person who has a buying role. Discovery: Entered when the first discovery call has happened and the pain is written down. Solution fit: Entered when the buyer has seen a tailored demo and agreed the product fits the pain. Technical validation: Entered when a trial or technical review is agreed, with named evaluators and dates. Proposal: Entered when the economic buyer has confirmed budget and asked for pricing. Negotiation: Entered when the buyer has reviewed the proposal and is discussing terms. Contract out: Entered when final terms are agreed and the contract has been sent for signature. Closed won: Entered when the signed contract is received and the subscription record is created. Closed lost: Entered when the buyer says no, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_business/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
