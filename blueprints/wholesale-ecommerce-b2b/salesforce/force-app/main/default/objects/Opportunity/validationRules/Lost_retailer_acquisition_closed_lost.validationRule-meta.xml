<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lost_retailer_acquisition_closed_lost</fullName>
    <active>true</active>
    <description>Lost reason: Retailer acquisition, Closed lost needs Lost reason.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Retailer_acquisition", ISPICKVAL(StageName, "Closed lost"), ISBLANK(TEXT(Lost_reason__c)))</errorConditionFormula>
    <errorDisplayField>Lost_reason__c</errorDisplayField>
    <errorMessage>Fill in Lost reason before closing this as Closed lost.</errorMessage>
</ValidationRule>
