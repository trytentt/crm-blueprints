  "order": 2,
  "requests": [
    {
      "method": "POST",
      "path": "/v2/objects/companies/attributes",
      "body": {
        "data": {
          "title": "Territory",
          "description": "Puts each retailer in one territory so ownership and targets are clear.",
          "api_slug": "territory",
          "type": "record-reference",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {
            "record_reference": {
              "allowed_objects": [
                "territories"
              ]
            }
          },
          "relationship": {
            "object": "territories",
            "title": "Retailers",
            "api_slug": "retailers",
            "is_multiselect": true
          }
        }
      }
    },
    {
