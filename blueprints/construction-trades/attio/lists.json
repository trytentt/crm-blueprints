    {
      "method": "POST",
      "path": "/v2/lists/tender_estimate/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Tender and estimate pipeline. Opportunity: Entered when a named client contact has an actual project with a site and a rough scope. Go or no-go: Entered when the tender documents or brief have been received and the bid decision is being made. Estimating: Entered when the decision is go and a site visit or drawings review has been done. Bid submitted: Entered when the priced bid has been sent to the client. Clarification: Entered when the client has asked for clarifications, a revised price or an interview. Preferred bidder: Entered when the client has told us in writing that we are preferred or recommended for award. Awarded: Entered when the contract, order or letter of intent is signed and a project record is created. Closed lost: Entered when the client awards elsewhere, withdraws, or we decide not to bid.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/tender_estimate/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
