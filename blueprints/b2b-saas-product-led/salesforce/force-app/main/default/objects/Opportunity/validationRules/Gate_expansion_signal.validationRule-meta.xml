<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gate_expansion_signal</fullName>
    <active>true</active>
    <description>Stage gate: Expansion, Expansion signal and later stages need Expansion type.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Expansion", CASE(StageName, "Expansion signal", 1, "Outreach", 2, "Proposal (Expansion)", 3, "Negotiation", 4, "Expanded", 5, 0) &gt;= 1, ISBLANK(TEXT(Expansion_type__c)))</errorConditionFormula>
    <errorDisplayField>Expansion_type__c</errorDisplayField>
    <errorMessage>Fill in Expansion type before moving to Expansion signal.</errorMessage>
</ValidationRule>
