          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_accounts/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the New accounts pipeline. Identified: Entered when a target company with a buying need is logged and has a named contact. First contact: Entered when a conversation with a purchasing contact has happened and the products of interest are noted. Needs confirmed: Entered when the technical contact has confirmed the specification and the expected volumes. Sample or trial: Entered when a sample, trial run or spec approval has been requested. Quote issued: Entered when a priced quote has been sent against a confirmed specification. Terms agreed: Entered when the buyer has accepted price and lead time and credit terms are being set up. Closed won: Entered when the first purchase order is received from the account. Closed lost: Entered when the buyer chooses another supplier or goes silent after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_accounts/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
