<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gate_expansion_outreach</fullName>
    <active>true</active>
    <description>Stage gate: Expansion, Outreach and later stages need Next step date.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Expansion", CASE(StageName, "Expansion signal", 1, "Outreach", 2, "Proposal (Expansion)", 3, "Negotiation", 4, "Expanded", 5, 0) &gt;= 2, ISBLANK(Next_step_date__c))</errorConditionFormula>
    <errorDisplayField>Next_step_date__c</errorDisplayField>
    <errorMessage>Fill in Next step date before moving to Outreach.</errorMessage>
</ValidationRule>
