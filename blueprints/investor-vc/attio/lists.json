      "path": "/v2/lists/portfolio_outcome/attributes",
      "body": {
        "data": {
          "title": "Write-off reason",
          "description": "Why the investment was written off. Required on the written-off stage.",
          "api_slug": "write_off_reason",
          "type": "select",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
