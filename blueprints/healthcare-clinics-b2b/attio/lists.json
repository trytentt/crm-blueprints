    {
      "method": "POST",
      "path": "/v2/lists/employer_insurer_contracts/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Employer and insurer contracts pipeline. Qualified: Entered when a named buyer at an employer or insurer has a stated need and enough people to be worth a contract. Discovery: Entered when the first needs call has happened and sites, headcount and services are written down. Proposal: Entered when a priced proposal with services and pricing model has been sent. Governance review: Entered when the buyer has started their data protection, clinical governance or procurement review. Pilot: Entered when a pilot has been agreed in writing and has a start date. Contract out: Entered when the governance review is passed and the contract has been sent for signature. Closed won: Entered when the signed contract is received and a service contract record is created. Closed lost: Entered when the buyer says no, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/employer_insurer_contracts/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
