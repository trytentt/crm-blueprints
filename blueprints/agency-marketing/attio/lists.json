    {
      "method": "POST",
      "path": "/v2/lists/new_business/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the New business pipeline. Lead: Entered when a company has asked for help or accepted a first conversation. Discovery: Entered when a discovery call has happened with someone who can name the goal and the budget range. Brief and scope: Entered when the client has given a written brief and agreed we should prepare a proposal. Proposal sent: Entered when a priced proposal has been sent to the decision maker. Pitch or review: Entered when the client has asked for a pitch session or a proposal walk-through with more than one stakeholder. Negotiation: Entered when the client has said we are the preferred agency and is discussing scope, fee or terms. Closed won: Entered when the signed statement of work or agreement is received and the engagement record is created. Closed lost: Entered when the client chooses someone else or says no, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_business/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
