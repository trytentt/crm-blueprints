<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Gate_expansion_negotiation</fullName>
    <active>true</active>
    <description>Stage gate: Expansion, Negotiation and later stages need Amount and Close date.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Expansion", CASE(StageName, "Expansion signal", 1, "Outreach", 2, "Proposal (Expansion)", 3, "Negotiation", 4, "Expanded", 5, 0) &gt;= 4, OR(ISBLANK(Amount), ISBLANK(CloseDate)))</errorConditionFormula>
    <errorMessage>Fill in Amount and Close date before moving to Negotiation.</errorMessage>
</ValidationRule>
