    {
      "method": "POST",
      "path": "/v2/lists/project_delivery/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Project delivery pipeline. Pre-start: Entered when the project record is created from an awarded deal. Mobilising: Entered when the project manager is named and RAMS and insurance checks are under way. On site: Entered when work has started on site. Snagging: Entered when the main works are finished and the client's snag list has been issued. Defects period: Entered when practical completion is certified and retention is being held. Closed out: Entered when defects are cleared, retention is released and the final account is agreed. Cancelled: Entered when the project is stopped before practical completion.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
