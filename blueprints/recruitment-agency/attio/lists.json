    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "Placement",
          "api_slug": "placement",
          "parent_object": "submissions",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/placement/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Placement pipeline. Sourced: Entered when a candidate has been matched to the role and the consultant has recorded how they were found. Screened: Entered when the consultant has spoken to the candidate and confirmed interest, salary expectation and availability. Submitted: Entered when the candidate has been formally sent to the client with their agreement. Interviewing: Entered when the client has booked a first interview with the candidate. Offer: Entered when the client has said they want to make an offer. Offer accepted: Entered when the candidate has accepted in writing and a start date is agreed. Placed: Entered when the candidate has started and the fee amount is recorded. Rejected: Entered when the client or the candidate ends the process, or the role is filled by someone else.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
