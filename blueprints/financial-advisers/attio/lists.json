        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/review_cycle/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Review cycle pipeline. Due: Entered when the household is within 90 days of its review due date. Invited: Entered when the client has been sent the review invitation and questionnaire. Booked: Entered when the review meeting is in the diary. Meeting held: Entered when the review meeting has taken place. Review completed: Entered when the review letter has been sent and follow-up actions are logged. Not completed: Entered when the review will not happen in this cycle, because the client declined or could not be reached.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
