<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lost_expansion_declined</fullName>
    <active>true</active>
    <description>Lost reason: Expansion, Declined needs Lost reason.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Expansion", ISPICKVAL(StageName, "Declined"), ISBLANK(TEXT(Lost_reason__c)))</errorConditionFormula>
    <errorDisplayField>Lost_reason__c</errorDisplayField>
    <errorMessage>Fill in Lost reason before closing this as Declined.</errorMessage>
</ValidationRule>
