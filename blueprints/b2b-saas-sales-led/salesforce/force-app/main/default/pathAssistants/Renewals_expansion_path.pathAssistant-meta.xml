<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>Opportunity</entityName>
    <fieldName>StageName</fieldName>
    <masterLabel>Renewals and expansion path</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Renewal_type__c</fieldNames>
        <info>Entered when the subscription is 90 days from its renewal date.</info>
        <picklistValueName>Upcoming</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Renewal_risk__c</fieldNames>
        <fieldNames>Next_step_date__c</fieldNames>
        <info>Entered when the success owner has contacted the champion about the renewal.</info>
        <picklistValueName>Outreach</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Contract_term_months__c</fieldNames>
        <info>Entered when a renewal quote has been sent to the buyer.</info>
        <picklistValueName>Proposal sent</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <info>Entered when the buyer has asked for changes to price or terms.</info>
        <picklistValueName>Negotiation (Renewals and expansion)</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <fieldNames>Contract_term_months__c</fieldNames>
        <info>Entered when the final renewal contract has been sent for signature.</info>
        <picklistValueName>Awaiting signature</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <info>Entered when the signed renewal is received and the subscription dates are updated.</info>
        <picklistValueName>Renewed</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Lost_reason__c</fieldNames>
        <info>Entered when the customer confirms they will not renew, or the term ends unsigned.</info>
        <picklistValueName>Churned</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>Renewals_expansion</recordTypeName>
</PathAssistant>
