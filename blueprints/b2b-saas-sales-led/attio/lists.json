        "data": {
          "title": "Stage",
          "description": "Stage of the Renewals and expansion pipeline. Upcoming: Entered when the subscription is 90 days from its renewal date. Outreach: Entered when the success owner has contacted the champion about the renewal. Proposal sent: Entered when a renewal quote has been sent to the buyer. Negotiation: Entered when the buyer has asked for changes to price or terms. Awaiting signature: Entered when the final renewal contract has been sent for signature. Renewed: Entered when the signed renewal is received and the subscription dates are updated. Churned: Entered when the customer confirms they will not renew, or the term ends unsigned.",
          "api_slug": "stage",
          "type": "status",
