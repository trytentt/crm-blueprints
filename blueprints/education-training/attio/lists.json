        "data": {
          "title": "Stage",
          "description": "Stage of the Delegate enrolment pipeline. Enquiry: Entered when a delegate or their employer has asked about a specific cohort. Applied: Entered when a completed booking form or application has been received. Place offered: Entered when eligibility and funding have been checked and a place has been offered in writing. Awaiting payment: Entered when the delegate has accepted the place and an invoice or purchase order request is out. Enrolled: Entered when payment, a purchase order or an approved funding route is confirmed for the place. Withdrawn: Entered when the delegate or employer declines or withdraws before the cohort starts, or the cohort is cancelled.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
