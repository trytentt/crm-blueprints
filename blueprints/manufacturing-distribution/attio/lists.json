    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "RFQ handling",
          "api_slug": "rfq_handling",
          "parent_object": "quotes",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/rfq_handling/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the RFQ handling pipeline. Received: Entered when an RFQ is logged with the customer, the source and the date received. Qualified: Entered when the team has decided to quote, the product family is set and a due date is agreed. Pricing: Entered when stock or capacity is checked and a lead time is set. Approval: Entered when the price is built and breaks a margin or credit rule that needs manager sign-off. Sent: Entered when the quote has been sent to the buyer with a validity date. Follow-up: Entered when the first chase has been made and the buyer has given a decision date. Accepted: Entered when the buyer sends a purchase order or written acceptance against the quote. Declined: Entered when the buyer rejects the quote, the validity date passes unanswered, or the business decides not to quote.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/rfq_handling/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
