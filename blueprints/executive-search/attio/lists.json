      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Candidate progress pipeline. Identified: Entered when a person is on the longlist for a search and has no contact restriction. Approached: Entered when the first confidential approach has been made. Engaged: Entered when the person has replied and agreed to talk about the role. Assessed: Entered when we have completed a full interview and rated the person. Shortlisted: Entered when the candidate's profile has been presented to the client with their agreement. Client interview: Entered when the client has scheduled an interview with the candidate. Offer: Entered when the client has said they want to make an offer to the candidate. Placed: Entered when the candidate has accepted the offer in writing and a start date is agreed. Out: Entered when the candidate withdraws or is declined at any step.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
