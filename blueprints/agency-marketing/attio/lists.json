    {
      "method": "POST",
      "path": "/v2/lists/delivery/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Delivery pipeline. Onboarding: Entered when the engagement record is created from a won deal and a delivery lead is named. Kickoff done: Entered when the kickoff meeting has happened and access to the client's accounts has been received. First deliverables: Entered when the first agreed deliverable or report has been sent to the client. Steady state: Entered when the first monthly review has taken place and the client has accepted the reporting format. At risk: Entered when health is set to red, or the client has raised a written concern. Wrapping up: Entered when the engagement is within 30 days of its end date and no renewal is agreed. Completed: Entered when the work is delivered to scope and the engagement has reached its end date or been renewed into a new engagement. Terminated: Entered when the client or the agency has given notice to end the engagement early.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
