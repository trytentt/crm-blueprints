<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lost_retainer_renewals_not_renewed</fullName>
    <active>true</active>
    <description>Lost reason: Retainer renewals, Not renewed needs Lost reason.</description>
    <errorConditionFormula>AND(RecordType.DeveloperName = "Retainer_renewals", ISPICKVAL(StageName, "Not renewed"), ISBLANK(TEXT(Lost_reason__c)))</errorConditionFormula>
    <errorDisplayField>Lost_reason__c</errorDisplayField>
    <errorMessage>Fill in Lost reason before closing this as Not renewed.</errorMessage>
</ValidationRule>
