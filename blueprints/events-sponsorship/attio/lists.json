      "body": {
        "data": {
          "name": "Sponsor sales",
          "api_slug": "sponsor_sales",
          "parent_object": "deals",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/sponsor_sales/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Sponsor sales pipeline. Prospect: Entered when a target company and a named marketing contact have been identified for an event. Meeting held: Entered when a discovery call has happened and the sponsor's goals are written down. Proposal sent: Entered when a proposal tied to the sponsor's goals, with tier and price, has been sent. Negotiating: Entered when the sponsor has asked for changes to the package, price or terms. Contract out: Entered when final terms are agreed and the contract has been sent for signature. Signed: Entered when the signed contract is received and a fulfilment record is created. Closed lost: Entered when the sponsor says no, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/sponsor_sales/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/sponsor_sales/attributes",
