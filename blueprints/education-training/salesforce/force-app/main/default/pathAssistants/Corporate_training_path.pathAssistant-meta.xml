<?xml version="1.0" encoding="UTF-8"?>
<PathAssistant xmlns="http://soap.sforce.com/2006/04/metadata">
    <active>true</active>
    <entityName>Opportunity</entityName>
    <fieldName>StageName</fieldName>
    <masterLabel>Corporate training path</masterLabel>
    <pathAssistantSteps>
        <fieldNames>Training_need__c</fieldNames>
        <fieldNames>Next_step_date__c</fieldNames>
        <info>Entered when a named contact has a real training need and the provider can meet it.</info>
        <picklistValueName>Enquiry qualified</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Needs_summary__c</fieldNames>
        <fieldNames>Delegate_count__c</fieldNames>
        <fieldNames>Next_step_date__c</fieldNames>
        <info>Entered when the first call with the learning lead or budget holder has happened and the gap is written down.</info>
        <picklistValueName>Needs analysis</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Delivery_format__c</fieldNames>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Funding_source__c</fieldNames>
        <info>Entered when a written proposal with programme, dates, format and price has been sent.</info>
        <picklistValueName>Proposal sent</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Budget_confirmed__c</fieldNames>
        <fieldNames>Next_step_date__c</fieldNames>
        <info>Entered when the budget holder has confirmed budget and the proposal is being reviewed by others.</info>
        <picklistValueName>Stakeholder review</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>Proposed_start_date__c</fieldNames>
        <fieldNames>Delegate_count__c</fieldNames>
        <info>Entered when price, dates and delegate numbers are agreed and a booking form has been sent.</info>
        <picklistValueName>Terms agreed</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Amount</fieldNames>
        <fieldNames>CloseDate</fieldNames>
        <fieldNames>Purchase_order_received__c</fieldNames>
        <info>Entered when the signed booking form or purchase order is received and a cohort or enrolments are created.</info>
        <picklistValueName>Booked</picklistValueName>
    </pathAssistantSteps>
    <pathAssistantSteps>
        <fieldNames>Lost_reason__c</fieldNames>
        <info>Entered when the buyer says no, or has not replied after three follow-ups over 30 days.</info>
        <picklistValueName>Closed lost</picklistValueName>
    </pathAssistantSteps>
    <recordTypeName>Corporate_training</recordTypeName>
</PathAssistant>
