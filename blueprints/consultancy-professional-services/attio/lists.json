    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "New work",
          "api_slug": "new_work",
          "parent_object": "deals",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_work/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the New work pipeline. Enquiry: Entered when a prospective client or referrer has asked us about a piece of work. Qualified: Entered when a partner has agreed the work is in our expertise, we have capacity, and the prospect has been told fees are charged. Conflict check: Entered when the parties have been sent to risk or compliance for a conflict check. Proposal: Entered when the conflict check is cleared and a scoped proposal with a billing model is being prepared. Proposal sent: Entered when the proposal has been sent to the instructing decision maker. Terms agreed: Entered when the client has accepted the scope and fees in principle and is waiting for the engagement letter. Engagement letter out: Entered when the engagement letter has been sent for signature. Closed won: Entered when the signed engagement letter is received and the matter record is created. Closed lost: Entered when the prospect declines, we decline the work, or there has been no reply after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_work/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_work/attributes",
      "body": {
        "data": {
          "title": "Lost reason",
          "description": "Why the deal was lost or the client left. Required on every lost stage.",
          "api_slug": "lost_reason",
