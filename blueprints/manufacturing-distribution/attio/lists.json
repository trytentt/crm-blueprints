      "path": "/v2/lists/rfq_handling/attributes",
      "body": {
        "data": {
          "title": "Decline reason",
          "description": "Why the quote was lost or not quoted. Required on the lost stage.",
          "api_slug": "decline_reason",
          "type": "select",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
