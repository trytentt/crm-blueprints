        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "Portfolio outcome",
          "api_slug": "portfolio_outcome",
          "parent_object": "portfolio_investments",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/portfolio_outcome/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Portfolio outcome pipeline. Active: Entered when the investment is made and recorded. Follow-on review: Entered when the company is raising again or has asked for more capital. Exit preparation: Entered when the partners agree to start planning a sale or listing. Exit process: Entered when an acquirer or listing process is under way with a signed letter of intent or mandate. Exited: Entered when proceeds from the sale or listing have been received. Written off: Entered when the company has closed or the holding is written down to nil.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
