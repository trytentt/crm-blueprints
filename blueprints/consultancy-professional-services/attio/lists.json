    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "Matter delivery",
          "api_slug": "matter_delivery",
          "parent_object": "matters",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/matter_delivery/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Matter delivery pipeline. Opening: Entered when the matter record is created from a won deal and a responsible partner is named. Cleared to start: Entered when the engagement letter is signed and identity checks are complete or not required. In progress: Entered when work has started and time is being recorded against the matter. Awaiting client: Entered when we are blocked on information or a decision from the client. Final billing: Entered when the work is delivered and the final invoice is being prepared. Closed: Entered when the work is delivered, the final invoice is issued and the file is closed. Withdrawn: Entered when the client or the firm has ended the matter before the work was complete.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
