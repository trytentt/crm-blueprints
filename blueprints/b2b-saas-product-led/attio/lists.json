      "body": {
        "data": {
          "name": "Sales assist",
          "api_slug": "sales_assist",
          "parent_object": "deals",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/sales_assist/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Sales assist pipeline. Product-qualified lead: Entered when a workspace meets the PQL rule and a sales-assist rep has accepted it. Conversation: Entered when the rep has spoken to a workspace admin or owner. Need confirmed: Entered when the buyer has named what they need beyond the current plan and who approves spend. Proposal: Entered when a quote has been sent for a named plan, seat count and billing term. Negotiation: Entered when the buyer has asked for changes to price, terms or security answers. Closed won: Entered when the paid plan is live in the product and payment terms are accepted. Closed lost: Entered when the buyer says no, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/sales_assist/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
