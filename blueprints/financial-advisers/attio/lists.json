    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "Advice delivery",
          "api_slug": "advice_delivery",
          "parent_object": "advice_cases",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/advice_delivery/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Advice delivery pipeline. Fact find: Entered when the client agreement is signed and the fact find has been issued to the household. Analysis: Entered when the fact find and supporting documents are complete and checked. Report drafted: Entered when the recommendation report is drafted and sent for internal checking. Report issued: Entered when the checked report has been sent to the client and a meeting to discuss it is booked. Accepted: Entered when the client has decided to proceed with some or all recommendations. Completed: Entered when applications are placed and the client has confirmation of every agreed action. Closed without advice: Entered when the case ends before completion because the client withdrew or the practice could not advise.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/advice_delivery/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
