      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Exhibitor sales pipeline. Enquiry: Entered when a company has asked about a stand or been contacted and replied. Qualified: Entered when the exhibitor's goals and space needs have been discussed. Space held: Entered when a specific stand has been offered with a price and held for a stated number of days. Contract sent: Entered when the booking form and terms have been sent for signature. Confirmed: Entered when the signed booking form and deposit are received and a fulfilment record is created. Closed lost: Entered when the company declines, or the held space is released with no booking.",
          "api_slug": "stage",
          "type": "status",
