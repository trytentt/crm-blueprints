      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Corporate training pipeline. Enquiry qualified: Entered when a named contact has a real training need and the provider can meet it. Needs analysis: Entered when the first call with the learning lead or budget holder has happened and the gap is written down. Proposal sent: Entered when a written proposal with programme, dates, format and price has been sent. Stakeholder review: Entered when the budget holder has confirmed budget and the proposal is being reviewed by others. Terms agreed: Entered when price, dates and delegate numbers are agreed and a booking form has been sent. Booked: Entered when the signed booking form or purchase order is received and a cohort or enrolments are created. Closed lost: Entered when the buyer says no, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
