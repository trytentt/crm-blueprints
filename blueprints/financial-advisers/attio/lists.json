    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "New client",
          "api_slug": "new_client",
          "parent_object": "deals",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_client/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the New client pipeline. Enquiry: Entered when a prospect is logged with a referral source and a way to contact them. Initial meeting booked: Entered when the free initial meeting is in the diary. Initial meeting held: Entered when the initial meeting has taken place and services and fees have been explained. Fee proposal: Entered when a written proposal of services and fees has been sent. Agreement out: Entered when the prospect has said yes to the proposal and the client agreement has been sent for signature. Client won: Entered when the client agreement is signed and identity checks are complete. Lost: Entered when the prospect declines, chooses another adviser or does not reply after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_client/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/new_client/attributes",
      "body": {
        "data": {
          "title": "Lost reason",
          "description": "Why the prospect did not become a client. Required on the lost stage.",
          "api_slug": "lost_reason",
