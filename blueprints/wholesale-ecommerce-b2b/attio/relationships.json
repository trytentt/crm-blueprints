          "description": "Shows the full order history for each retailer.",
          "api_slug": "retailer",
          "type": "record-reference",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {
            "record_reference": {
              "allowed_objects": [
                "companies"
              ]
            }
