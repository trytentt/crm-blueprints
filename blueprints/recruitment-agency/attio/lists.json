    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "Client development",
          "api_slug": "client_development",
          "parent_object": "deals",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/client_development/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Client development pipeline. Target: Entered when a company with a likely hiring need is chosen for outreach and a hiring contact is identified. Conversation: Entered when a hiring manager has spoken to us about a current or planned hire. Terms discussed: Entered when the client has asked for our fees and terms of business. Terms sent: Entered when the terms of business have been sent to someone with authority to sign. Terms signed: Entered when the signed terms of business are received and the company terms status is set to signed. Not won: Entered when the client declines terms, or has not replied after three follow-ups over 30 days.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/client_development/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/client_development/attributes",
      "body": {
        "data": {
