      "body": {
        "data": {
          "title": "Budget changed"
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/letting/attributes/lost_reason/options",
      "body": {
        "data": {
          "title": "Requirement withdrawn"
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/letting/attributes/lost_reason/options",
      "body": {
        "data": {
          "title": "Landlord withdrew"
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/letting/attributes/lost_reason/options",
      "body": {
        "data": {
          "title": "No response"
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists",
      "body": {
        "data": {
          "name": "Lease renewal",
          "api_slug": "lease_renewal",
          "parent_object": "leases",
          "workspace_access": "full-access",
          "workspace_member_access": []
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/lease_renewal/attributes",
      "body": {
        "data": {
          "title": "Stage",
          "description": "Stage of the Lease renewal pipeline. Upcoming: Entered when the lease is within 12 months of its expiry or break date. Tenant contacted: Entered when the tenant's intentions have been asked for and noted. Terms discussed: Entered when the landlord and tenant are negotiating new rent and term. Renewal agreed: Entered when heads of terms for the renewal are agreed and solicitors are instructed. Renewed: Entered when the renewal lease or variation is signed and the dates on the record are updated. Not renewed: Entered when the tenant leaves or the lease ends without renewal.",
          "api_slug": "stage",
          "type": "status",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/lease_renewal/attributes",
      "body": {
        "data": {
          "title": "Probability",
          "description": "Win probability in percent (0 to 100) for the current stage. Attio does not enforce it: set it to match the stage.",
          "api_slug": "probability",
          "type": "number",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
      "method": "POST",
      "path": "/v2/lists/lease_renewal/attributes",
      "body": {
        "data": {
          "title": "Outcome reason",
          "description": "Why a lease was not renewed. Required on the lost renewal stage.",
          "api_slug": "outcome_reason",
          "type": "select",
          "is_required": false,
          "is_unique": false,
          "is_multiselect": false,
          "config": {}
        }
      }
    },
    {
